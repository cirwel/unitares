#!/usr/bin/env bash
# UNITARES CLI — thin REST wrapper for the governance MCP server.
# Usage: unitares <command> [args...]
#
# Environment:
#   UNITARES_URL          Base URL (default: http://localhost:8767). A trailing
#                         "/" or "/mcp" or "/mcp/" is stripped automatically so
#                         accidental MCP-path suffixes don't break REST calls.
#   UNITARES_AGENT        Stable agent name for X-Agent-Id (default:
#                         cli-<shorthost>-<user>). Identity is bound to this.
#   UNITARES_TOKEN        Optional bearer token; sent as Authorization header.
#   UNITARES_SESSION_FILE Path to the local session JSON (default:
#                         ~/.unitares_session.json). Onboard uses cached
#                         uuid only as parent_agent_id lineage.

set -u
set -o pipefail

# --- config ------------------------------------------------------------------

_raw_url="${UNITARES_URL:-http://localhost:8767}"
# Strip trailing slash, then any trailing /mcp (common mistake when pasting
# the streamable-http URL into UNITARES_URL).
_raw_url="${_raw_url%/}"
_raw_url="${_raw_url%/mcp}"
_raw_url="${_raw_url%/}"
UNITARES_URL="$_raw_url"

SESSION_FILE="${UNITARES_SESSION_FILE:-${HOME}/.unitares_session.json}"

_default_agent="cli-$(hostname -s 2>/dev/null || echo host)-${USER:-user}"
AGENT_ID="${UNITARES_AGENT:-$_default_agent}"

TIMEOUT="${UNITARES_TIMEOUT:-15}"

# --- session store -----------------------------------------------------------

_py_read_field() {
    local field="$1"
    [ -f "$SESSION_FILE" ] || return 0
    SESSION_FILE="$SESSION_FILE" FIELD="$field" python3 -c '
import json, os, sys
try:
    with open(os.environ["SESSION_FILE"]) as f:
        data = json.load(f)
except Exception:
    sys.exit(0)
value = data.get(os.environ["FIELD"])
if value is not None:
    print(value)
' 2>/dev/null
}

_py_write_session() {
    SESSION_FILE="$SESSION_FILE" AGENT_ID="$AGENT_ID" CSID="${1:-}" CTOKEN="${2:-}" UUID="${3:-}" PARENT="${4:-}" python3 -c '
import json, os
payload = {"agent_id": os.environ["AGENT_ID"]}
sid = os.environ.get("CSID") or ""
token = os.environ.get("CTOKEN") or ""
uuid = os.environ.get("UUID") or ""
parent = os.environ.get("PARENT") or ""
if uuid:
    payload["uuid"] = uuid
if sid:
    payload["client_session_id"] = sid
if token:
    payload["continuity_token"] = token
if parent:
    payload["parent_agent_id"] = parent
    payload["spawn_reason"] = "new_session"
with open(os.environ["SESSION_FILE"], "w") as f:
    json.dump(payload, f, indent=2)
'
}

STORED_UUID="$(_py_read_field uuid || true)"
STORED_SESSION_ID="$(_py_read_field client_session_id || true)"
SESSION_ID="$STORED_SESSION_ID"
CONT_TOKEN="$(_py_read_field continuity_token || true)"

# --- HTTP --------------------------------------------------------------------

_base_headers=(
    -H "Content-Type: application/json"
    -H "X-Agent-Id: ${AGENT_ID}"
)
[ -n "${UNITARES_TOKEN:-}" ] && _base_headers+=( -H "Authorization: Bearer ${UNITARES_TOKEN}" )

_curl_fetch() {
    # _curl_fetch <method> <path> [post-body] [include-session-header]
    # Prints body on 2xx, emits error + returns 1 on any other HTTP status,
    # and returns 2 on network failure.
    local method="$1" path="$2" body="${3:-}" include_session="${4:-1}"
    local tmp code curl_rc
    local headers=("${_base_headers[@]}")
    if [ "$include_session" = "1" ] && [ -n "${SESSION_ID:-}" ]; then
        headers+=( -H "X-Session-ID: ${SESSION_ID}" )
    fi
    tmp=$(mktemp -t unitares_cli_XXXXXX)
    if [ "$method" = "POST" ]; then
        code=$(curl -s --max-time "$TIMEOUT" "${headers[@]}" \
            -X POST -d "$body" \
            -o "$tmp" -w "%{http_code}" "${UNITARES_URL}${path}")
        curl_rc=$?
    else
        code=$(curl -s --max-time "$TIMEOUT" "${headers[@]}" \
            -o "$tmp" -w "%{http_code}" "${UNITARES_URL}${path}")
        curl_rc=$?
    fi
    if [ $curl_rc -ne 0 ] || [ "$code" = "000" ]; then
        echo "error: could not reach ${UNITARES_URL}${path} (curl exit ${curl_rc}, http ${code})" >&2
        echo "hint: run 'unitares diag' to check reachability; UNITARES_URL=${UNITARES_URL}" >&2
        rm -f "$tmp"
        return 2
    fi
    if [ "${code:0:1}" != "2" ]; then
        echo "error: HTTP ${code} from ${UNITARES_URL}${path}" >&2
        if [ "${UNITARES_DEBUG:-0}" = "1" ]; then
            echo "--- response body ---" >&2
            head -c 2000 "$tmp" >&2
            echo >&2
        else
            echo "hint: set UNITARES_DEBUG=1 to see response body; check UNITARES_URL." >&2
        fi
        rm -f "$tmp"
        return 1
    fi
    cat "$tmp"
    rm -f "$tmp"
}

_curl_get() {
    _curl_fetch GET "$1"
}

_curl_post_tool() {
    local tool="$1" args="${2:-{\}}"
    # Inject known in-session transport continuity for ordinary calls, but
    # never onto force_new startup onboards. continuity_token is deliberately
    # not auto-injected; it is only for explicit PATH 0 ownership rebinds.
    local payload include_session
    payload=$(TOOL="$tool" RAW_ARGS="$args" CSID="${SESSION_ID:-}" python3 -c '
import json, os, sys
tool = os.environ["TOOL"]
raw_args = os.environ.get("RAW_ARGS") or "{}"
sid = os.environ.get("CSID") or ""
try:
    args = json.loads(raw_args) if raw_args else {}
except json.JSONDecodeError as exc:
    sys.stderr.write(f"error: invalid JSON for arguments: {exc}\n")
    sys.exit(2)
if not isinstance(args, dict):
    sys.stderr.write("error: arguments must be a JSON object\n")
    sys.exit(2)
inject = not bool(args.get("force_new"))
if inject and sid:
    args.setdefault("client_session_id", sid)
print(json.dumps({"name": tool, "arguments": args}))
') || return $?
    include_session=$(RAW_ARGS="$args" python3 -c '
import json, os
try:
    args = json.loads(os.environ.get("RAW_ARGS") or "{}")
except Exception:
    args = {}
print("0" if isinstance(args, dict) and bool(args.get("force_new")) else "1")
')
    _curl_fetch POST "/v1/tools/call" "$payload" "$include_session"
}

_check_body() {
    local body="$1" what="$2"
    if [ -z "$body" ]; then
        echo "error: empty response from ${UNITARES_URL} (${what})" >&2
        echo "hint: check 'unitares diag' — the server may be unreachable or the URL has a stale path." >&2
        return 1
    fi
    printf '%s' "$body"
}

# --- pretty-printers ---------------------------------------------------------

_pretty_json() {
    python3 -c "import json,sys; print(json.dumps(json.loads(sys.stdin.read()), indent=2))" 2>/dev/null || cat
}

parse_health() {
    local body; body=$(cat)
    BODY="$body" python3 -c '
import json, os, sys
try:
    data = json.loads(os.environ["BODY"])
except Exception as exc:
    print("error: bad JSON from /health: " + str(exc), file=sys.stderr)
    sys.exit(1)
print("Status:  " + str(data.get("status", "?")))
print("Version: " + str(data.get("version", "?")))
uptime = data.get("uptime") or {}
print("Uptime:  " + str(uptime.get("formatted", "?")))
db = data.get("database") or {}
print("DB:      " + str(db.get("status", "?")) + " (pool " + str(db.get("pool_size", "?")) + "/" + str(db.get("pool_max", "?")) + ")")
'
}

parse_onboard() {
    local body; body=$(cat)
    BODY="$body" python3 -c '
import json, os, sys
try:
    data = json.loads(os.environ["BODY"])
except Exception as exc:
    print("error: bad JSON from onboard: " + str(exc), file=sys.stderr)
    sys.exit(1)
r = data.get("result") or {}
# Fail on both outer envelope (data.success) and the tool-level success
# field (r.success) — when an existing identity has an established
# trajectory the outer envelope is still true but r.success is false
# with a recovery hint.
if data.get("success") is False or not r or r.get("success") is False:
    msg = r.get("error") or data.get("error") or "onboard failed"
    print("error: " + str(msg), file=sys.stderr)
    recovery = r.get("recovery") or {}
    hint = recovery.get("hint") if isinstance(recovery, dict) else None
    if hint:
        print("hint: " + str(hint), file=sys.stderr)
    sys.exit(1)
welcome = (r.get("welcome") or r.get("message") or "onboarded").strip()
print("Welcome: " + welcome[:200])
print("Agent:   " + str(r.get("display_name") or r.get("agent_id") or "?"))
print("UUID:    " + str(r.get("uuid", "?")))
'
}

parse_update() {
    local body; body=$(cat)
    BODY="$body" python3 -c '
import json, os, sys
try:
    data = json.loads(os.environ["BODY"])
except Exception as exc:
    print("error: bad JSON from process_agent_update: " + str(exc), file=sys.stderr)
    sys.exit(1)
r = data.get("result") or {}

def unwrap_update_payload(payload):
    current = payload
    for _ in range(2):
        if not isinstance(current, dict):
            return payload
        nested = current.get("result")
        has_update_fields = any(
            key in current for key in ("action", "verdict", "decision", "status", "metrics", "mirror", "margin")
        )
        if isinstance(nested, dict) and not has_update_fields:
            current = nested
            continue
        return current
    return current

r = unwrap_update_payload(r)
if data.get("success") is False or not r or r.get("success") is False:
    msg = data.get("error") or r.get("error") or "update failed"
    print("error: " + str(msg), file=sys.stderr)
    recovery = r.get("recovery") or {}
    hint = recovery.get("hint") if isinstance(recovery, dict) else None
    if hint:
        print("hint: " + str(hint), file=sys.stderr)
    sys.exit(1)
decision = r.get("decision") if isinstance(r.get("decision"), dict) else {}
metrics = r.get("metrics") if isinstance(r.get("metrics"), dict) else {}
verdict = (
    r.get("action")
    or decision.get("action")
    or r.get("verdict")
    or metrics.get("verdict")
    or r.get("status")
    or "?"
)
print("Verdict: " + str(verdict))
margin = r.get("margin")
if margin is None:
    margin = decision.get("margin")
if margin is not None:
    print("Margin:  " + str(margin))
mirror = r.get("mirror") or []
for line in mirror[:3]:
    print("  - " + str(line))
ia = r.get("identity_assurance") or {}
if ia:
    print("Identity: " + str(ia.get("tier", "?")) + " (" + str(ia.get("session_source", "?")) + ")")
'
}

parse_metrics() {
    local body; body=$(cat)
    BODY="$body" python3 -c '
import json, os, sys
try:
    data = json.loads(os.environ["BODY"])
except Exception as exc:
    print("error: bad JSON from get_governance_metrics: " + str(exc), file=sys.stderr)
    sys.exit(1)
r = data.get("result") or {}
if not r:
    print("error: empty metrics response", file=sys.stderr)
    sys.exit(1)
def v(x):
    return x.get("value", x) if isinstance(x, dict) else x
def f(x):
    try:
        return format(float(x), ".2f")
    except Exception:
        return str(x)
E = v(r.get("E", 0))
I = v(r.get("I", 0))
S = v(r.get("S", 0))
V = v(r.get("V", 0))
print("Agent:   " + str(r.get("display_name") or r.get("agent_id", "?")))
print("Status:  " + str(r.get("status", "?")))
print("EISV:    E=" + f(E) + " I=" + f(I) + " S=" + f(S) + " V=" + f(V))
print("Summary: " + str(r.get("summary", "?")))
'
}

parse_tools() {
    local body; body=$(cat)
    BODY="$body" python3 -c '
import json, os, sys
try:
    data = json.loads(os.environ["BODY"])
except Exception as exc:
    print("error: bad JSON from /v1/tools: " + str(exc), file=sys.stderr)
    sys.exit(1)
tools = data.get("tools") or []
count = data.get("count") or len(tools)
total = data.get("total_available", "?")
mode = data.get("mode", "?")
print("Tools: " + str(count) + "/" + str(total) + " (" + str(mode) + " mode)")
def tool_name_desc(tool):
    if not isinstance(tool, dict):
        return str(tool), ""
    # OpenAI-style: {"type":"function","function":{"name":...,"description":...}}
    fn = tool.get("function")
    if isinstance(fn, dict):
        return str(fn.get("name", "?")), str(fn.get("description", ""))
    # Fallback: flat shape
    return str(tool.get("name", "?")), str(tool.get("description") or tool.get("hint") or "")
for tool in tools[:20]:
    name, desc = tool_name_desc(tool)
    first_line = desc.split(".")[0][:60]
    print("  " + name.ljust(32) + " " + first_line)
more = len(tools) - 20
if more > 0:
    print("  ... +" + str(more) + " more")
'
}

# --- commands ----------------------------------------------------------------

cmd_diag() {
    echo "UNITARES_URL    : ${UNITARES_URL}"
    echo "UNITARES_AGENT  : ${AGENT_ID}"
    echo "SESSION_FILE    : ${SESSION_FILE}"
    echo "UUID            : ${STORED_UUID:-<none>}"
    echo "SESSION_ID      : ${SESSION_ID:-<none>}"
    [ -n "${CONT_TOKEN:-}" ] && echo "CONTINUITY      : present (len=${#CONT_TOKEN})" || echo "CONTINUITY      : <none>"
    echo
    echo -n "Reachability    : "
    local code
    code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 5 "${UNITARES_URL}/health" || echo "000")
    if [ "$code" = "200" ]; then
        echo "OK (${code})"
    else
        echo "FAIL (${code})"
        return 1
    fi
}

cmd_onboard() {
    local name="${1:-$AGENT_ID}" purpose="${2:-}" force="${3:-}"
    local args
    args=$(NAME="$name" PURPOSE="$purpose" FORCE="$force" PARENT_UUID="${STORED_UUID:-}" python3 -c '
import json, os
args = {"name": os.environ["NAME"], "force_new": True}
purpose = os.environ.get("PURPOSE") or ""
if purpose:
    args["purpose"] = purpose
force = (os.environ.get("FORCE") or "").lower()
if force not in ("1", "true", "force", "yes", "--force"):
    parent = os.environ.get("PARENT_UUID") or ""
    if parent:
        args["parent_agent_id"] = parent
        args["spawn_reason"] = "new_session"
print(json.dumps(args))
')
    local body
    body=$(_curl_post_tool "onboard" "$args") || return 1
    _check_body "$body" "onboard" >/dev/null || return 1

    # Check tool-level success BEFORE writing the session file. If the
    # server returned result.success:false (e.g. trajectory_required), we
    # must not clobber any existing continuity material.
    local tool_ok
    tool_ok=$(BODY="$body" python3 -c '
import json, os
try:
    data = json.loads(os.environ["BODY"])
    r = data.get("result") or {}
    if data.get("success") is False:
        print("no"); exit()
    if r.get("success") is False:
        print("no"); exit()
    if not r:
        print("no"); exit()
    print("yes")
except Exception:
    print("no")
')
    if [ "$tool_ok" != "yes" ]; then
        printf '%s' "$body" | parse_onboard
        return 1
    fi

    # Extract session + continuity token + uuid in a single python invocation.
    local extracted sid token token_uuid uuid parent
    extracted=$(BODY="$body" python3 -c '
import json, os
try:
    data = json.loads(os.environ["BODY"])
    r = data.get("result") or {}
    print((r.get("client_session_id") or "") + "\t" + (r.get("continuity_token") or "") + "\t" + (r.get("uuid") or ""))
except Exception:
    print("\t\t")
')
    sid="${extracted%%	*}"
    token_uuid="${extracted#*	}"
    token="${token_uuid%%	*}"
    uuid="${token_uuid#*	}"
    parent=$(ARGS="$args" python3 -c '
import json, os
try:
    args = json.loads(os.environ["ARGS"])
    print(args.get("parent_agent_id") or "")
except Exception:
    print("")
')
    _py_write_session "$sid" "$token" "$uuid" "$parent"
    printf '%s' "$body" | parse_onboard
    echo "Session: ${sid:-<none>}"
}

cmd_update() {
    local text="${1:-Update}" complexity="${2:-0.5}" confidence="${3:-0.6}"
    local args
    args=$(TEXT="$text" COMPLEXITY="$complexity" CONFIDENCE="$confidence" python3 -c '
import json, os, sys
try:
    complexity = float(os.environ.get("COMPLEXITY") or 0.5)
    confidence = float(os.environ.get("CONFIDENCE") or 0.6)
except ValueError as exc:
    sys.stderr.write("error: complexity/confidence must be numeric: " + str(exc) + "\n")
    sys.exit(2)
print(json.dumps({
    "response_text": os.environ.get("TEXT") or "",
    "complexity": complexity,
    "confidence": confidence,
}))
') || return 1
    local body
    body=$(_curl_post_tool "process_agent_update" "$args") || return 1
    _check_body "$body" "process_agent_update" >/dev/null || return 1
    printf '%s' "$body" | parse_update
}

cmd_metrics() {
    local body
    body=$(_curl_post_tool "get_governance_metrics" "{}") || return 1
    _check_body "$body" "get_governance_metrics" >/dev/null || return 1
    printf '%s' "$body" | parse_metrics
}

cmd_health() {
    local body
    body=$(_curl_get "/health") || return 1
    _check_body "$body" "/health" >/dev/null || return 1
    printf '%s' "$body" | parse_health
}

cmd_tools() {
    local body
    body=$(_curl_get "/v1/tools") || return 1
    _check_body "$body" "/v1/tools" >/dev/null || return 1
    printf '%s' "$body" | parse_tools
}

cmd_call() {
    local tool="${1:-}" args="${2:-{\}}"
    if [ -z "$tool" ]; then
        echo "usage: unitares call <tool_name> [args_json]" >&2
        return 2
    fi
    local body
    body=$(_curl_post_tool "$tool" "$args") || return 1
    _check_body "$body" "tool:$tool" >/dev/null || return 1
    printf '%s' "$body" | _pretty_json
}

cmd_status() {
    # One operator screen: server health, release currency, agent tiers,
    # resident roster. /health is required; the other panels degrade
    # per-endpoint so an older server still gets a status screen.
    #
    # Read-only by design: plain GETs, no onboard, no check-in, no
    # X-Session-ID side effects beyond what every other read command sends.
    # `watch -n5 unitares status` is the intended live view.
    local json_mode=0 no_release=0 arg
    for arg in "$@"; do
        case "$arg" in
            --json) json_mode=1 ;;
            --no-release) no_release=1 ;;
            *)
                echo "error: unknown status option '${arg}' (--json, --no-release)" >&2
                return 2
                ;;
        esac
    done

    local health residents tiers latest errbuf auth_hint=0
    # /health is the one required panel — but its 503 during the post-restart
    # warmup window (connection-tracker middleware) is a legitimate state, not
    # an error, and a restart is the single most likely moment to run a status
    # screen. Render it as such instead of dying on the raw HTTP error.
    errbuf=$(mktemp -t unitares_cli_XXXXXX)
    if ! health=$(_curl_get "/health" 2>"$errbuf"); then
        if grep -q "HTTP 503 " "$errbuf" 2>/dev/null; then
            # The body was discarded by _curl_fetch, so this cannot prove the
            # 503 came from the warmup middleware rather than a proxy in
            # front of the server — say so instead of over-claiming.
            rm -f "$errbuf"
            if [ "$json_mode" = "1" ]; then
                printf '%s\n' '{"health": {"status": "warming_up"}, "residents": null, "tiers": null, "auth_required": false, "release": {"current": null, "latest": null, "comparison": "unknown"}}'
            else
                echo "UNITARES warming up — /health answered 503 (server starting, or a proxy error); retry shortly"
            fi
            return 0
        fi
        cat "$errbuf" >&2
        rm -f "$errbuf"
        return 1
    fi
    rm -f "$errbuf"
    _check_body "$health" "/health" >/dev/null || return 1
    # Degradable panels — but auth failures stay distinguishable from missing
    # endpoints. /health is public while both panels are auth-gated, so in
    # hosted posture with no UNITARES_TOKEN a healthy screen would otherwise
    # read "(unavailable on this server)" and send the operator chasing a
    # version mismatch when the remediation is a token.
    errbuf=$(mktemp -t unitares_cli_XXXXXX)
    residents=$(_curl_get "/v1/residents" 2>"$errbuf") || residents=""
    grep -q "HTTP 40[13] " "$errbuf" 2>/dev/null && auth_hint=1
    tiers=$(_curl_get "/v1/agents/tier_distribution" 2>"$errbuf") || tiers=""
    grep -q "HTTP 40[13] " "$errbuf" 2>/dev/null && auth_hint=1
    rm -f "$errbuf"

    # Release currency against the newest GitHub release tag. Unauthenticated
    # and free (execution-cost policy: nothing metered), 3s budget, and silent
    # on ANY failure — offline, rate-limited, or disabled must never degrade
    # the status screen, so "unknown" prints nothing rather than guessing.
    # UNITARES_RELEASE_CHECK=off for air-gapped installs and deterministic tests.
    #
    # The lookup result (including a miss) is cached for 30 minutes: the
    # documented usage is `watch -n5 unitares status`, and an uncached call at
    # that cadence is 720 req/h against GitHub's 60/h unauthenticated limit —
    # it would exhaust the per-IP quota in five minutes and go dark for the
    # rest of the hour anyway. Caching the miss keeps a rate-limited hour from
    # being made worse by continued polling.
    local release_state="on"
    latest=""
    if [ "$no_release" = "1" ] || [ "${UNITARES_RELEASE_CHECK:-on}" = "off" ]; then
        release_state="disabled"
    else
        local release_url cache now cached_at cached_tag
        release_url="${UNITARES_RELEASE_URL:-https://api.github.com/repos/${UNITARES_RELEASE_REPO:-cirwel/unitares}/releases?per_page=100}"
        # Cache key includes the effective URL: keyed by UID alone, switching
        # UNITARES_RELEASE_REPO to a fork would reuse the other repo's cached
        # tag and report a wrong currency verdict for up to 30 minutes.
        cache="${UNITARES_RELEASE_CACHE:-${TMPDIR:-/tmp}/.unitares_release_check_$(id -u)_$(printf '%s' "$release_url" | cksum | cut -d' ' -f1)}"
        now=$(date +%s)
        cached_at=0
        cached_tag=""
        if [ -f "$cache" ]; then
            read -r cached_at cached_tag < "$cache" 2>/dev/null || cached_at=0
            case "$cached_at" in ''|*[!0-9]*) cached_at=0 ;; esac
            # Force base 10 (a leading zero would make $((...)) parse octal
            # and error on 08/09), and never trust a future timestamp — it
            # would pin stale data past the TTL indefinitely.
            cached_at=$((10#$cached_at))
            [ "$cached_at" -gt "$now" ] && cached_at=0
        fi
        if [ $((now - cached_at)) -lt 1800 ]; then
            latest="$cached_tag"
        else
            # /releases (not /releases/latest): this repo carries a second,
            # separately-versioned release line (sdk-v*), and /releases/latest
            # is date-ordered across all of them — the moment an SDK release is
            # newest, the server line would silently vanish. Take the newest
            # release whose tag looks like a server version instead. The
            # parser also accepts a single release object so a URL override
            # pointing at /releases/latest (or a test stub) still works.
            latest=$(curl -fsS --max-time 3 "$release_url" 2>/dev/null | python3 -c '
import json, re, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
releases = data if isinstance(data, list) else [data]
for rel in releases:
    if not isinstance(rel, dict) or rel.get("draft") or rel.get("prerelease"):
        continue
    tag = rel.get("tag_name") or ""
    # At least two dotted components: a bare "7" or "V2" is not a server
    # release tag (the contract is vX.Y.Z; extra components are tolerated
    # because the comparison pads).
    if re.fullmatch(r"[vV]?\d+\.\d+(\.\d+)*", tag):
        print(tag)
        break
' 2>/dev/null) || latest=""
            printf '%s %s\n' "$now" "$latest" > "$cache" 2>/dev/null || true
        fi
    fi

    HEALTH="$health" RESIDENTS="$residents" TIERS="$tiers" LATEST="$latest" \
    RELEASE_STATE="$release_state" AUTH_HINT="$auth_hint" \
    JSON_MODE="$json_mode" python3 -c '
import json, os, sys

def load(name):
    raw = os.environ.get(name) or ""
    try:
        value = json.loads(raw)
    except Exception:
        return None
    return value if isinstance(value, dict) else None

health = load("HEALTH")
if health is None:
    print("error: bad JSON from /health", file=sys.stderr)
    sys.exit(1)
residents = load("RESIDENTS")
tiers = load("TIERS")
latest = (os.environ.get("LATEST") or "").strip()
auth_hint = os.environ.get("AUTH_HINT") == "1"
version = str(health.get("version", "?"))

def vtuple(tag):
    parts = tag.lstrip("vV").split(".")
    try:
        return tuple(int(p) for p in parts)
    except ValueError:
        return None

comparison = "disabled" if os.environ.get("RELEASE_STATE") == "disabled" else "unknown"
if latest:
    cur, new = vtuple(version), vtuple(latest)
    if cur is not None and new is not None:
        # Pad to equal length so v2.20 vs 2.20.0 compares as equal instead of
        # producing a false ahead/behind claim from tuple-length ordering.
        width = max(len(cur), len(new))
        cur = cur + (0,) * (width - len(cur))
        new = new + (0,) * (width - len(new))
        comparison = "behind" if new > cur else ("ahead" if cur > new else "current")
    elif latest.lstrip("vV") == version:
        comparison = "current"

if os.environ.get("JSON_MODE") == "1":
    print(json.dumps({
        "health": health,
        "residents": residents,
        "tiers": tiers,
        "auth_required": auth_hint,
        "release": {
            "current": version,
            "latest": latest or None,
            "comparison": comparison,
        },
    }, indent=2))
    sys.exit(0)

build = str(health.get("build_sha", "") or "")
uptime = health.get("uptime")
uptime = uptime.get("formatted", "?") if isinstance(uptime, dict) else "?"
db = health.get("database")
db = db if isinstance(db, dict) else {}
head = "UNITARES " + str(health.get("status", "?")) + " · v" + version
if build:
    head += " (" + build + ")"
head += " · up " + str(uptime) + " · db " + str(db.get("status", "?"))
print(head)

# One message per failure cause: a 401/403 on the auth-gated panels means
# "set UNITARES_TOKEN", while a missing route means "older server" — the two
# remediations are different, so the lines must be too.
unavailable = ("(auth required — set UNITARES_TOKEN)" if auth_hint
               else "(unavailable on this server)")

if comparison == "behind":
    print("Release:   " + latest + " available (running v" + version + ")")
elif comparison == "current":
    print("Release:   current (" + latest + " is latest)")
elif comparison == "ahead":
    print("Release:   ahead of " + latest + " (development build)")
# unknown: check disabled or unreachable — print nothing rather than guess.

if tiers is not None and isinstance(tiers.get("tiers"), dict):
    counts = tiers["tiers"]
    # "unknown" is the no-tier bucket, not a peer tier — the endpoint computes
    # `earned` separately to preserve exactly that distinction, so keep it out
    # of the earned-tier list and name it for what it is.
    order = ["verified", "established", "emerging", "provisional"]
    parts = [str(counts[k]) + " " + k for k in order if k in counts]
    parts += [str(v) + " " + k for k, v in counts.items()
              if k not in order and k != "unknown"]
    line = "Agents:    " + str(tiers.get("total", "?")) + " total"
    if tiers.get("earned") is not None:
        line += " · " + str(tiers["earned"]) + " earned"
    if parts:
        line += " · " + " · ".join(parts)
    if counts.get("unknown") is not None:
        line += " · " + str(counts["unknown"]) + " untiered"
    print(line)
else:
    print("Agents:    " + unavailable)

def ago(seconds):
    try:
        seconds = float(seconds)
    except (TypeError, ValueError, OverflowError):
        return "?"
    if seconds < 90:
        return str(int(seconds)) + "s ago"
    if seconds < 5400:
        return str(int(seconds // 60)) + "m ago"
    return "%.1fh ago" % (seconds / 3600)

if residents is None or not isinstance(residents.get("residents"), list):
    print("Residents: " + unavailable)
else:
    rows = [r for r in residents["residents"] if isinstance(r, dict)]
    configured = residents.get("configured")
    configured = configured if isinstance(configured, list) else []
    if not rows and not configured:
        print("Residents: none configured (residentless install)")
    else:
        # Headline counts statuses, not rows: the endpoint emits one row per
        # configured label unconditionally, so "N reporting / N configured"
        # is a tautology that can contradict the rows right below it.
        tally = {}
        for row in rows:
            key = str(row.get("status") or "?")
            tally[key] = tally.get(key, 0) + 1
        summary = " · ".join(
            str(n) + " " + s
            for s, n in sorted(tally.items(), key=lambda kv: -kv[1])
        )
        line = "Residents: " + str(len(configured)) + " configured"
        if summary:
            line += " · " + summary
        print(line)
        if rows:
            print("  %-16s %-10s %-10s %s" % ("LABEL", "STATUS", "VERDICT", "LAST SIGNAL"))
        for row in rows:
            # The endpoint computes silence_threshold_seconds and event_driven
            # precisely so silence can be judged; a bare duration renders a
            # 65x-overdue resident identically to an expected quiet one.
            signal = ago(row.get("silence_seconds"))
            threshold = row.get("silence_threshold_seconds")
            try:
                overdue = (not row.get("event_driven")
                           and float(row.get("silence_seconds")) > float(threshold))
            except (TypeError, ValueError, OverflowError):
                overdue = False
            if overdue:
                signal += " (over threshold)"
            elif row.get("event_driven"):
                signal += " (event-driven)"
            print("  %-16s %-10s %-10s %s" % (
                str(row.get("label") or "?"),
                str(row.get("status") or "?"),
                str(row.get("verdict") or "-"),
                signal,
            ))
'
}

cmd_agent() {
    # Drill into ONE agent: identity, current state, trajectory, composition.
    #
    # Built on GET /v1/agents/<id>/history, which is path-scoped and genuinely
    # per-agent. Deliberately NOT on /v1/eisv/latest or /v1/eisv/recent: both
    # accept an agent_id query param and silently ignore it, returning whatever
    # the broadcaster saw last across the whole fleet. Rendering another
    # agent's vector under this one's heading is the exact failure this command
    # exists to avoid, so it does not read those routes at all.
    local json_mode=0 arg agent=""
    for arg in "$@"; do
        case "$arg" in
            --json) json_mode=1 ;;
            -*) echo "error: unknown agent option '${arg}' (only --json)" >&2; return 2 ;;
            *)
                if [ -n "$agent" ]; then
                    echo "error: give one agent id, not two ('${agent}' and '${arg}')" >&2
                    return 2
                fi
                agent="$arg"
                ;;
        esac
    done
    if [ -z "$agent" ]; then
        echo "usage: unitares agent <agent-id|resident-label> [--json]" >&2
        return 2
    fi

    # A resident label is the handle an operator actually has in front of them
    # (`unitares status` prints labels, not UUIDs), so accept either and let
    # /v1/residents do the mapping. No lookup-by-label against the identity
    # store: the roster is a display surface, and resolving a name to an
    # identity anywhere else is how ghost-identity bugs start.
    local residents resolved
    residents=$(_curl_get "/v1/residents" 2>/dev/null) || residents=""
    resolved=$(RESIDENTS="$residents" WANT="$agent" python3 -c '
import json, os, sys
want = os.environ["WANT"]
try:
    rows = (json.loads(os.environ.get("RESIDENTS") or "{}") or {}).get("residents") or []
except Exception:
    rows = []
for row in rows:
    if not isinstance(row, dict):
        continue
    if str(row.get("label", "")).lower() == want.lower() and row.get("agent_id"):
        print(row["agent_id"])
        break
' 2>/dev/null)
    [ -n "$resolved" ] && agent="$resolved"

    local history
    history=$(_curl_get "/v1/agents/${agent}/history?limit=200") || return 1
    _check_body "$history" "/v1/agents/${agent}/history" >/dev/null || return 1

    HISTORY="$history" RESIDENTS="$residents" ASKED="$agent" \
    JSON_MODE="$json_mode" python3 -c '
import json, os, sys

try:
    hist = json.loads(os.environ["HISTORY"])
except Exception:
    print("error: bad JSON from the history endpoint", file=sys.stderr)
    sys.exit(1)
if not isinstance(hist, dict):
    print("error: unexpected history shape", file=sys.stderr)
    sys.exit(1)

asked = os.environ["ASKED"]
echoed = str(hist.get("agent_id") or "")
points = [p for p in (hist.get("points") or []) if isinstance(p, dict)]

# The label, if this agent is a resident. Display only.
label = None
try:
    for row in (json.loads(os.environ.get("RESIDENTS") or "{}") or {}).get("residents") or []:
        if isinstance(row, dict) and row.get("agent_id") == echoed:
            label = row.get("label")
            break
except Exception:
    pass

if os.environ.get("JSON_MODE") == "1":
    print(json.dumps({
        "agent_id": echoed or asked,
        "label": label,
        "requested": asked,
        "identity_confirmed": bool(echoed) and echoed == asked,
        "history": hist,
    }, indent=2))
    sys.exit(0)

# An endpoint that answers about a DIFFERENT agent than the one asked for is
# the failure mode this command was written around; say so rather than render
# it under the wrong heading.
if echoed and echoed != asked:
    print("error: asked for " + asked + " but the server answered about "
          + echoed + " — refusing to render it as the requested agent",
          file=sys.stderr)
    sys.exit(1)

head = "AGENT " + (echoed or asked)
if label:
    head += " · " + str(label)
print(head)

if not points:
    total = hist.get("total")
    if total in (0, None):
        print("No governance state recorded for this agent.")
        print("An identity can exist without ever checking in — minted by")
        print("authentication, never used. That is a real state, not an error.")
    else:
        print("No points in this window (total on record: " + str(total) + ").")
    sys.exit(0)

latest = points[-1]

def num(value, fmt="%.2f"):
    try:
        return fmt % float(value)
    except (TypeError, ValueError):
        return "?"

print("State:     E " + num(latest.get("E")) + "  I " + num(latest.get("I"))
      + "  S " + num(latest.get("S")) + "  V " + num(latest.get("V"))
      + "  · coherence " + num(latest.get("coherence"))
      + " · risk " + num(latest.get("risk")))

verdict = latest.get("verdict") or latest.get("action") or "-"
print("Verdict:   " + str(verdict) + " · as of " + str(latest.get("t") or "?"))

# Composition, not choice: who COMPOSED these rows. A population that is 98%
# substrate interpretation says something very different about a trajectory
# than one that is agent-authored, and the endpoint already separates them.
summary = hist.get("observation_summary")
if isinstance(summary, dict):
    parts = []
    for key, name in (
        ("agent_reports", "agent-authored"),
        ("substrate_rows", "substrate"),
        ("other_rows", "other"),
    ):
        value = summary.get(key)
        if value:
            parts.append(str(value) + " " + name)
    if parts:
        print("Composed:  " + " · ".join(parts)
              + " (of " + str(summary.get("state_rows", "?")) + " rows)")

count = hist.get("count")
total = hist.get("total")
print("History:   " + str(count) + " shown of " + str(total) + " on record")

# Sparkline over the window. Flat is meaningful here — a resident that never
# moves is a different story from one that oscillates — so a constant series
# renders as a flat line rather than being scaled into false variation.
def spark(series):
    blocks = "\u2581\u2582\u2583\u2584\u2585\u2586\u2587\u2588"
    values = []
    for point in series:
        try:
            values.append(float(point))
        except (TypeError, ValueError):
            values.append(None)
    real = [v for v in values if v is not None]
    if not real:
        return ""
    low, high = min(real), max(real)
    if high - low < 1e-9:
        return blocks[3] * len(values)
    out = []
    for v in values:
        if v is None:
            out.append(" ")
        else:
            idx = int((v - low) / (high - low) * (len(blocks) - 1))
            out.append(blocks[idx])
    return "".join(out)

window = points[-48:]
for name in ("E", "I", "S", "V"):
    line = spark([p.get(name) for p in window])
    if line:
        print("  " + name + "  " + line)
if len(window) > 1:
    print("     " + str(window[0].get("t") or "?")[:16]
          + "  ->  " + str(window[-1].get("t") or "?")[:16])
'
}

cmd_session() {
    echo "Agent ID:     ${AGENT_ID}"
    echo "Session file: ${SESSION_FILE}"
    echo "UUID:         ${STORED_UUID:-<none>}"
    echo "Session ID:   ${SESSION_ID:-<none>}"
    [ -n "${CONT_TOKEN:-}" ] && echo "Continuity:   present" || echo "Continuity:   <none>"
    echo "URL:          ${UNITARES_URL}"
}

cmd_reset() {
    rm -f "$SESSION_FILE"
    echo "Session reset. Next onboard will create a fresh identity for agent '${AGENT_ID}'."
}

cmd_help() {
    cat <<'EOF'
UNITARES CLI — REST wrapper for the governance MCP server

Commands:
  agent <id|label> [--json]         Drill into one agent: state, verdict,
                                    composition, trajectory
  status [--json] [--no-release]    One operator screen: server, release
                                    currency, agent tiers, residents. Pure
                                    reads; try: watch -n30 unitares status
  onboard [name] [purpose] [force]  Onboard a fresh identity; cached uuid is
                                    declared as parent_agent_id unless "force"
                                    is passed as 3rd arg
  update "text" [complexity] [confidence]
                                    Post a governance check-in (defaults: 0.5 / 0.6)
  metrics                           Show EISV + summary
  health                            Server health (GET /health)
  tools                             List available tools (GET /v1/tools)
  call <tool> [args_json]           Invoke any tool by name
  session                           Show local session/identity state
  reset                             Clear local session
  diag                              Print config and server reachability
  help                              Show this message

Environment:
  UNITARES_URL       Base URL (default: http://localhost:8767; /mcp suffix stripped)
  UNITARES_AGENT     Stable agent name for X-Agent-Id
  UNITARES_TOKEN     Optional bearer token
  UNITARES_TIMEOUT   curl --max-time seconds (default: 15)
  UNITARES_RELEASE_CHECK   "off" disables the GitHub release-currency lookup
                           in `status` (same as --no-release; air-gapped
                           installs; the lookup always fails silently anyway
                           and its result is cached for 30 minutes)
  UNITARES_RELEASE_REPO    GitHub repo the release check queries
                           (default: cirwel/unitares — forks should point
                           this at themselves or disable the check)

Examples:
  unitares diag
  unitares onboard "kenny-laptop" "interactive dev work"
  unitares update "Fixed CLI sanitization bug" 0.4 0.9
  unitares metrics
  unitares call list_agents '{}'
EOF
}

# --- dispatch ----------------------------------------------------------------

case "${1:-help}" in
    status|st)   shift; cmd_status "$@" ;;
    agent|a)     shift; cmd_agent "$@" ;;
    onboard|o)   shift; cmd_onboard "$@" ;;
    update|u)    shift; cmd_update "$@" ;;
    metrics|m)   shift; cmd_metrics ;;
    health|h)    shift; cmd_health ;;
    tools|t)     shift; cmd_tools ;;
    call|c)      shift; cmd_call "$@" ;;
    session|s)   shift; cmd_session ;;
    reset)       shift; cmd_reset ;;
    diag|d)      shift; cmd_diag ;;
    help|--help|-h|*) cmd_help ;;
esac
