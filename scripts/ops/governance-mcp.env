# This operator's governance-mcp environment, applied to the live LaunchAgent
# plist by scripts/ops/deploy-mcp.sh on every deploy (apply_plist_env_overlay.py).
#
# Only deployment-specific values that the product deliberately does not ship
# as defaults belong here, so that no one has to hand-edit the live plist.
# Secrets never do: this file is tracked. A key listed here overwrites the
# plist's value on the next deploy; keys not listed are left alone, and
# removing a line leaves the plist's current value in place (edit the plist
# to unset it). This file can widen the auth bypass, so it is on the
# second-family review list (scripts/dev/review_policy.json).

# Callers on this deployment's Tailscale tailnet skip auth in local posture,
# as they did before #2560 made the CGNAT range opt-in.
UNITARES_TRUSTED_NETWORKS=100.64.0.0/10

# The embodied runtime on this deployment writes these source markers into
# outcome evidence. The server no longer builds them in (#2582); it trusts the
# markers listed here, which keeps this runtime's grades as they were.
UNITARES_TRUSTED_SUBSTRATE_MARKERS=pi_anima_eisv,get_lumen_context

# Observe the credential-issuance rule (src/mcp_handlers/identity/credential_issuance.py)
# before enforcing it here: identity()/onboard() still return credentials to a
# caller matched only by inference, and log [CREDENTIALS_WITHHELD] ... mode=log.
# Change it to enforce (the product default) once the log shows no client that
# depends on it; removing the line would leave the plist's log value in place.
UNITARES_CREDENTIAL_ISSUANCE=log
