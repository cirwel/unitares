<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    com.unitares.pr-babysitter - compatibility label for the serial autonomous
    merge conductor, evaluated every 5 minutes.

    Default posture is report-only. Set UNITARES_MERGE_CONDUCTOR_EXECUTE=1 only
    after the agent-review required status context is installed and the dry-run
    soak is accepted. An older installed plist with neither conductor variable
    receives the same safe default from the shell entrypoint. See
    docs/operations/merge-automation-plan.md.

    PATH must include the Homebrew bin dir: `gh` is /opt/homebrew/bin/gh and
    launchd's minimal PATH omits it. gh auth comes from ~/.config/gh under
    the user context launchd runs this in.

    Install (the doctor-findings pattern):
      sed "s|__UNITARES_ROOT__|$HOME/projects/unitares-deploy|g" \
        scripts/ops/com.unitares.pr-babysitter.plist.template \
        > ~/Library/LaunchAgents/com.unitares.pr-babysitter.plist
      launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.unitares.pr-babysitter.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.unitares.pr-babysitter</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__UNITARES_ROOT__/scripts/ops/pr-babysitter.sh</string>
    </array>
    <key>WorkingDirectory</key><string>__UNITARES_ROOT__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>UNITARES_MERGE_CONDUCTOR_EXECUTE</key><string>0</string>
        <key>UNITARES_MERGE_CONDUCTOR_REVIEW</key><string>0</string>
    </dict>
    <key>StartInterval</key><integer>300</integer>
    <key>StandardOutPath</key><string>__UNITARES_ROOT__/data/logs/pr-babysitter.log</string>
    <key>StandardErrorPath</key><string>__UNITARES_ROOT__/data/logs/pr-babysitter.err</string>
</dict>
</plist>
