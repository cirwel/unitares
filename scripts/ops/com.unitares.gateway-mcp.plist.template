<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd manifest for the Gateway MCP server (reduced-surface proxy on :8768).

  The gateway exposes a 6-tool subset of the full governance MCP for weak
  external clients (e.g. Cursor). It proxies to the governance server on :8767.

  Production: render __UNITARES_ROOT__ against a MASTER-PINNED worktree
  (e.g. ~/projects/unitares-deploy), NOT the shared dev checkout — else a
  concurrent session that switches the dev checkout's branch will deploy the
  wrong code on this service's next restart. (governance-mcp + agent-orchestrator
  already run from pinned worktrees; the [DEV] services were pinned 2026-06-29.)

  Install (render __VARS__ then load):
    sed -e "s|__UNITARES_ROOT__|$HOME/projects/unitares|g" \
        -e "s|__HOME__|$HOME|g" \
        -e "s|__PYTHON3__|$(command -v python3)|g" \
        scripts/ops/com.unitares.gateway-mcp.plist.template \
        > ~/Library/LaunchAgents/com.unitares.gateway-mcp.plist
    launchctl load ~/Library/LaunchAgents/com.unitares.gateway-mcp.plist

  Verify:
    launchctl list | grep com.unitares.gateway-mcp
    curl -s http://localhost:8768/health
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.unitares.gateway-mcp</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON3__</string>
        <string>__UNITARES_ROOT__/src/gateway_server.py</string>
        <string>--port</string>
        <string>8768</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__UNITARES_ROOT__</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__UNITARES_ROOT__/data/logs/gateway_server.log</string>

    <key>StandardErrorPath</key>
    <string>__UNITARES_ROOT__/data/logs/gateway_server_error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- Set to one token accepted by UNITARES_MCP_BEARER_TOKENS on the
             upstream governance server when its /mcp gate is enabled. -->
        <key>UNITARES_MCP_BEARER_TOKEN</key>
        <string></string>
        <!-- This surface is localhost-only until you widen it. The SDK locks a
             localhost server to Host: localhost/127.0.0.1, so a client reaching
             :8768 through a tunnel gets 421 on every MCP call while /health
             still answers 200. Add the tunnel host here, with and without the
             port wildcard:
                 your-gateway-host.example.org,your-gateway-host.example.org:*
             Deliberately SEPARATE from UNITARES_MCP_ALLOWED_HOSTS, which
             start_unitares.sh exports process-wide: widening that one would
             also admit the host to the full 76-tool server on :8767. This
             gateway exists to be the narrower surface. Unset = fall back to
             the shared list. -->
        <key>UNITARES_GATEWAY_ALLOWED_HOSTS</key>
        <string></string>
        <!-- Browser origins allowed to call the gateway. The opaque "null"
             origin (file:// pages, sandboxed iframes) is NOT allowed by
             default here, unlike on the governance server: this port is
             browser-reachable and two of the six tools write. Set
             UNITARES_GATEWAY_ALLOW_NULL_ORIGIN=1 only for a real file://
             client. -->
        <key>UNITARES_GATEWAY_ALLOWED_ORIGINS</key>
        <string></string>
        <key>PYTHONPATH</key>
        <string>__UNITARES_ROOT__/src</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
</dict>
</plist>
