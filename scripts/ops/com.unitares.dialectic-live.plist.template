<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd manifest for the dialectic_live Phoenix/LiveView app (Elixir/OTP, port 8790).

  The Phoenix UI-platform beachhead (one-pane strangler). Renders a live-ish
  dialectic-sessions pane, fed by the Python governance MCP (:8767): a
  Mint.WebSocket consumer of the broadcaster firehose (/ws/eisv) re-published onto
  Phoenix.PubSub, plus /v1/tools/call POSTs for dialectic list/get. Binds
  127.0.0.1:8790 by default (DIALECTIC_LIVE_BIND_ALL=1 to expose).

  Loading this plist starts the app: any KeepAlive implies RunAtLoad
  (launchd.plist(5)), so leaving RunAtLoad out does not keep a loaded job
  stopped. Load it only once its settings are in place. If they are missing,
  start.sh logs why and exits 0, and KeepAlive restarts the app only after a
  failing exit, so a premature load sits idle instead of looping.

  Prereq: set UNITARES_SECRETS_ENV to an absolute private file and persist that
  value in this job's EnvironmentVariables, or provision the required variables
  directly through your service manager. start.sh does not discover secret files.
  To initialize a selected file with the prod secret:
    : "${UNITARES_SECRETS_ENV:?select an absolute private secrets file}"
    echo "DIALECTIC_LIVE_SECRET_KEY_BASE=$(cd elixir/dialectic_live && mix phx.gen.secret)" \
      >> "$UNITARES_SECRETS_ENV"

  Install (render __VARS__ then load):
    sed -e "s|__UNITARES_ROOT__|$HOME/projects/unitares|g" \
        -e "s|__HOME__|$HOME|g" \
        scripts/ops/com.unitares.dialectic-live.plist.template \
        > ~/Library/LaunchAgents/com.unitares.dialectic-live.plist
    launchctl load ~/Library/LaunchAgents/com.unitares.dialectic-live.plist

  Verify:
    launchctl list | grep com.unitares.dialectic-live
    tail -f ~/Library/Logs/unitares-dialectic-live.log
    curl -s -o /dev/null -w "%{http_code}\n" http://127.0.0.1:8790/

  Unload (rollback):
    launchctl unload ~/Library/LaunchAgents/com.unitares.dialectic-live.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.unitares.dialectic-live</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__UNITARES_ROOT__/elixir/dialectic_live/scripts/start.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__UNITARES_ROOT__/elixir/dialectic_live</string>

    <!-- Restart only after a failing exit: start.sh exits 0 when the app is
         not configured, which must not become a restart loop. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/unitares-dialectic-live.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/unitares-dialectic-live.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>MIX_ENV</key>
        <string>prod</string>
        <key>PORT</key>
        <string>8790</string>
    </dict>
</dict>
</plist>
