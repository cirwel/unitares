{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unitares:schema:eisv-federation-combine-receipt:v1",
  "title": "EISV Federation Coordinator Combine Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "study_id", "read_id", "requested_at",
    "federation_id", "pilot_run_id", "coordinator_ledger_id",
    "registry_sha256", "report_sha256", "packages", "receipt_sha256"
  ],
  "properties": {
    "schema_version": { "const": "eisv-federation-combine-receipt.v1" },
    "study_id": { "const": "eisv-incremental-value-v1" },
    "read_id": { "$ref": "#/$defs/id" },
    "requested_at": { "type": "string", "format": "date-time" },
    "federation_id": { "$ref": "#/$defs/id" },
    "pilot_run_id": { "$ref": "#/$defs/id" },
    "coordinator_ledger_id": { "$ref": "#/$defs/id" },
    "registry_sha256": { "$ref": "#/$defs/sha256" },
    "report_sha256": { "$ref": "#/$defs/sha256" },
    "receipt_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "SHA-256 of the canonical receipt with this field omitted."
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "site_id", "release_subject_sha256", "package_sha256", "payload_sha256", "package_nonce",
          "export_sequence", "generated_at"
        ],
        "properties": {
          "site_id": { "$ref": "#/$defs/id" },
          "release_subject_sha256": { "$ref": "#/$defs/sha256" },
          "package_sha256": { "$ref": "#/$defs/sha256" },
          "payload_sha256": { "$ref": "#/$defs/sha256" },
          "package_nonce": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
          "export_sequence": { "type": "integer", "minimum": 1 },
          "generated_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
