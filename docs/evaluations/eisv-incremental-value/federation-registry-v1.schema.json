{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unitares:schema:eisv-federation-registry:v1",
  "title": "EISV Incremental-Value Federation Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "study_id", "dataset_namespace", "phase",
    "federation_id", "pilot_run_id", "registry_version", "created_at",
    "linkage_key_id", "coordinator_ledger_id", "privacy_policy",
    "expected_contract", "sites"
  ],
  "properties": {
    "schema_version": { "const": "eisv-federation-registry.v1" },
    "study_id": { "const": "eisv-incremental-value-v1" },
    "dataset_namespace": { "const": "eisv-incremental-value-v1" },
    "phase": { "const": "pilot" },
    "federation_id": { "$ref": "#/$defs/id" },
    "pilot_run_id": { "$ref": "#/$defs/id" },
    "registry_version": { "$ref": "#/$defs/id" },
    "created_at": { "type": "string", "format": "date-time" },
    "linkage_key_id": { "$ref": "#/$defs/id" },
    "coordinator_ledger_id": { "$ref": "#/$defs/id" },
    "privacy_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_cell_count", "minimum_export_interval_seconds",
        "maximum_exports_per_site"
      ],
      "properties": {
        "minimum_cell_count": { "type": "integer", "minimum": 2 },
        "minimum_export_interval_seconds": { "type": "integer", "minimum": 3600 },
        "maximum_exports_per_site": { "const": 1 }
      }
    },
    "expected_contract": { "$ref": "#/$defs/contract" },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "site_id", "key_id", "public_key_base64", "key_status",
          "key_valid_from", "key_valid_until", "required",
          "identity_namespace", "task_namespace", "shared_state_domain",
          "federation_unit_id"
        ],
        "properties": {
          "site_id": { "$ref": "#/$defs/id" },
          "key_id": { "$ref": "#/$defs/id" },
          "public_key_base64": { "type": "string", "minLength": 40, "maxLength": 60 },
          "key_status": { "enum": ["active", "revoked"] },
          "key_valid_from": { "type": "string", "format": "date-time" },
          "key_valid_until": { "type": "string", "format": "date-time" },
          "required": { "type": "boolean" },
          "identity_namespace": { "$ref": "#/$defs/id" },
          "task_namespace": { "$ref": "#/$defs/id" },
          "shared_state_domain": {
            "$ref": "#/$defs/id",
            "description": "Sites with the same value are conservatively one independence cluster."
          },
          "federation_unit_id": {
            "$ref": "#/$defs/id",
            "description": "Deployment/operator grouping used for concentration reporting."
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_sha256", "episode_schema_sha256", "protocol_version",
        "access_policy_version", "independence_resolver_version", "config_version",
        "feature_registry_version", "scorer_bundle_version",
        "instrument_validation_bundle_version"
      ],
      "properties": {
        "protocol_sha256": { "$ref": "#/$defs/sha256" },
        "episode_schema_sha256": { "$ref": "#/$defs/sha256" },
        "protocol_version": { "type": "string", "minLength": 1 },
        "access_policy_version": { "const": "eisv-incremental-access.v1" },
        "independence_resolver_version": { "type": "string", "minLength": 1 },
        "config_version": { "type": "string", "minLength": 1 },
        "feature_registry_version": { "type": "string", "minLength": 1 },
        "scorer_bundle_version": { "type": "string", "minLength": 1 },
        "instrument_validation_bundle_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
