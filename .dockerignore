# Git
.git
.gitignore

# Worktrees (must be excluded — they live under .git but resolve as real paths)
.worktrees

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info
dist
build
.venv
venv
env
uv.lock

# Data — mounted as volume by docker-compose
data/
data_isolated/
logs/
*.db
*.db-shm
*.db-wal

# IDE / tool config
.claude
.cursor
.vscode
.idea
*.swp
*.swo

# Tests + coverage (not needed in production image)
tests/
.pytest_cache
.coverage
coverage.xml
htmlcov/
.mypy_cache
.ruff_cache

# Documentation / non-runtime
papers/
scripts/archive/
docs/
site/
sketch/
examples/
reports/

# Archives
archive/
archives/

# Temporary
*.tmp
*.log
.DS_Store

# Node dev dependencies. The dashboard is buildless and neither Dockerfile
# runs npm, so node_modules is only ever a local artifact of running the
# dashboard test suite. Without this line a build from a working tree that
# has run npm install bakes it into the image; a clean CI checkout never
# had it, which is why this went unnoticed.
node_modules/

# Local env (don't bake secrets into image)
.env
.env.local
